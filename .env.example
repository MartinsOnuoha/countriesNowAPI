# ---------------------------------------------------------------------------
# Serving plane
# ---------------------------------------------------------------------------
# The API has no required configuration. It reads the artifact baked into the
# image and starts. Everything here is optional.

PORT=3000
NODE_ENV=development

# Path to the immutable SQLite artifact. Defaults to the newest file matching
# data/artifacts/countriesnow-*.sqlite, so you rarely need to set this.
# COUNTRIESNOW_ARTIFACT=data/artifacts/countriesnow-2026.08.0.sqlite

# Seconds for Cache-Control on versioned, immutable responses.
CACHE_MAX_AGE=86400

# ---------------------------------------------------------------------------
# Curation plane (harness only — never needed to run the API)
# ---------------------------------------------------------------------------

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/countriesnow
PG_POOL_MAX=8

# Where upstream snapshots and built artifacts land.
DATA_DIR=data

# GeoNames dump tier. cities15000 (3 MB) is enough for development;
# production releases should use allCountries (400 MB).
# One of: cities15000 | cities5000 | cities1000 | cities500 | allCountries
GEONAMES_TIER=cities15000

# ---------------------------------------------------------------------------
# Agent harness
# ---------------------------------------------------------------------------
# Any OpenAI-compatible endpoint. Without a key the harness still runs DETECT,
# the gates and the benchmark; only HYPOTHESIZE and VERIFY are skipped.

HARNESS_API_KEY=
HARNESS_BASE_URL=https://openrouter.ai/api/v1

# A cheap model over-produces candidates; an expensive one is spent only on
# trying to refute the survivors. See docs/HARNESS.md.
HARNESS_HYPOTHESIS_MODEL=openai/gpt-4o-mini
HARNESS_VERIFY_MODEL=anthropic/claude-sonnet-4.5

# Proposals below this verifier confidence are dropped before a human sees them.
HARNESS_MIN_CONFIDENCE=0.6

# Contact address sent in the User-Agent for Wikidata SPARQL, which blocks
# anonymous clients. Required only for the `retrieve` stage.
HARNESS_CONTACT=countriesnow@example.com

# Set to post proposals as pull requests. Without it, `propose` writes to disk.
GITHUB_TOKEN=
GITHUB_REPOSITORY=MartinsOnuoha/countriesNowAPI
